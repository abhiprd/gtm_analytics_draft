  "data_gap_ranking": [
    {
      "node_key": "workflow_chain_underutilization",
      "label": "Workflow chain under-utilization",
      "layer": 2,
      "parent_key": "contraction_churned_revenue",
      "tier": "B_phase2_mart_exposure_only",
      "blocked_node_count": 4,
      "blocks_full_layer1_metric": false,
      "rationale": "fact_workflow_chain_events already exists but is not exposed through any mart_* table. Closing this one mart gap would also close its three Layer-3 children (ingestion_without_completion_rate, mid_chain_abandonment, full_vs_partial_chain_share) -- notably, analytics/playbook_triggers.py's own ingestion_without_completion rule already computes a version of this signal for its own purpose, so this project's own other artifacts have already done some of this work."
    },
    {
      "node_key": "renewal_win_rate",
      "label": "Renewal win rate",
      "layer": 2,
      "parent_key": "contraction_churned_revenue",
      "tier": "B_phase2_mart_exposure_only",
      "blocked_node_count": 3,
      "blocks_full_layer1_metric": false,
      "rationale": "Same opportunity-detail mart-exposure gap. Blocks its own two Layer-3 children (time_to_respond_churn_risk_flag, loud_vs_silent_churn_mix) as well -- closing the parent mart gap would also need those two leaves' own source events (a churn-risk-flag timestamp, an AM response timestamp) which are a separate, smaller gap on top."
    },
    {
      "node_key": "discount_rate_vs_list",
      "label": "Discount rate vs. list",
      "layer": 3,
      "parent_key": "avg_initial_commitment",
      "tier": "B_phase2_mart_exposure_only",
      "blocked_node_count": 1,
      "blocks_full_layer1_metric": false,
      "rationale": "Already named and scoped in the Pricing/packaging analytics methods-doc entry as a separate, already-flagged piece of work: fact_opportunities is confirmed to expose list_price/discount_rate/loss_reason; the fix is a Phase 2 mart change (expose the columns through a mart), not new Phase 1 data."
    },
    {
      "node_key": "deal_size_trend_within_band",
      "label": "Deal-size trend within segment band",
      "layer": 3,
      "parent_key": "avg_initial_commitment",
      "tier": "B_phase2_mart_exposure_only",
      "blocked_node_count": 1,
      "blocks_full_layer1_metric": false,
      "rationale": "Same already-scoped fix as discount_rate_vs_list -- see that entry."
    },
    {
      "node_key": "loss_reason_mix",
      "label": "Loss-reason mix",
      "layer": 3,
      "parent_key": "win_rate",
      "tier": "B_phase2_mart_exposure_only",
      "blocked_node_count": 1,
      "blocks_full_layer1_metric": false,
      "rationale": "Same already-scoped fix as discount_rate_vs_list -- loss_reason is the field this leaf needs."
    },
    {
      "node_key": "stage_to_stage_conversion",
      "label": "Stage-to-stage conversion",
      "layer": 3,
      "parent_key": "win_rate",
      "tier": "B_phase2_mart_exposure_only",
      "blocked_node_count": 1,
      "blocks_full_layer1_metric": false,
      "rationale": "Needs fact_opportunity_stage_history's stage-transition detail exposed through a mart -- the raw fact already exists (fact_opportunity_stage_history), it is simply outside the mart_*-only read scope Phase 4 code operates under. Same root cause as poc_pass_rate, renewal_win_rate and churn_reason_category below -- one mart change could close several of these at once."
    },
    {
      "node_key": "poc_pass_rate",
      "label": "POC pass rate (Enterprise)",
      "layer": 3,
      "parent_key": "win_rate",
      "tier": "B_phase2_mart_exposure_only",
      "blocked_node_count": 1,
      "blocks_full_layer1_metric": false,
      "rationale": "Same stage-history mart-exposure gap as stage_to_stage_conversion."
    },
    {
      "node_key": "churn_reason_category",
      "label": "Churn reason category (loud vs. silent)",
      "layer": 2,
      "parent_key": "logo_retention",
      "tier": "B_phase2_mart_exposure_only",
      "blocked_node_count": 1,
      "blocks_full_layer1_metric": false,
      "rationale": "Same opportunity-detail (loss_reason) mart-exposure gap as the other opportunity-mart leaves."
    },
    {
      "node_key": "overage_realization",
      "label": "Overage realization",
      "layer": 2,
      "parent_key": "expansion_consumption_revenue",
      "tier": "B_phase2_mart_exposure_only",
      "blocked_node_count": 1,
      "blocks_full_layer1_metric": false,
      "rationale": "fact_committed_vs_utilized_monthly already exists and mart_efficiency already consumes it internally (exposing only a derived utilisation-haircut margin) -- realised overage billing itself just needs its own mart exposure, not new raw data."
    },
    {
      "node_key": "cost_per_channel_activity",
      "label": "Cost per channel activity",
      "layer": 3,
      "parent_key": "sm_cost",
      "tier": "B_phase2_mart_exposure_only",
      "blocked_node_count": 1,
      "blocks_full_layer1_metric": false,
      "rationale": "The cost side now exists (mart_efficiency.sm_cost, from fact_rep_monthly_cost and fact_marketing_spend), and so do the activity counts it divides by (fact_leads for cost/MQL, fact_sales_activities for cost/SDR meeting). What is missing is a mart that joins channel-level cost to per-channel lead and meeting counts -- a Phase 2 mart change, not new raw data. It is the one node left blocked under Magic number."
    },
    {
      "node_key": "rep_capacity_ramp_mix",
      "label": "Rep capacity / ramp mix",
      "layer": 3,
      "parent_key": "win_rate",
      "tier": "B_phase2_mart_exposure_only",
      "blocked_node_count": 1,
      "blocks_full_layer1_metric": false,
      "rationale": "dim_reps and int_rep_capacity_periods already exist with the needed ramp/quota detail; win rate cut by rep ramp status just needs a mart that joins deal ownership to that detail. Distinct root cause from the opportunity-detail group above -- a different mart, not the same fix."
    },
    {
      "node_key": "account_health_score",
      "label": "Account health score",
      "layer": 2,
      "parent_key": "contraction_churned_revenue",
      "tier": "C_phase4_code_or_design_fix",
      "blocked_node_count": 5,
      "blocks_full_layer1_metric": false,
      "rationale": "No new data and no new mart needed -- mart_account_health already carries everything. analytics/health_score.py's score_accounts() defines its scored population by customer_status = 'Active' (a final-status field), which biases a historical trailing series. Gating the population on churn_month > month instead (a code change to health_score.py, out of the variance-diagnostic engine's own scope per that entry's explicit note) would close this node and its four Layer-3 children -- the single largest node count closed by a pure code fix with zero new data anywhere in this catalog."
    },
    {
      "node_key": "marketing_sales_handoff_quality",
      "label": "Marketing-sales handoff quality",
      "layer": 2,
      "parent_key": "new_logo_consumption_revenue",
      "tier": "D_genuine_new_phase1_data",
      "blocked_node_count": 4,
      "blocks_full_layer1_metric": false,
      "rationale": "Needs an MQL/SAL lifecycle-stage field on the lead funnel. Verified directly against dbt/models/marts/facts/fact_leads.sql: the mart carries lead_id/account_id/channel/created_date/converted_date/is_converted/lead_score/days_to_conversion and nothing else -- no stage/status field of any kind, and the raw leads source has none either. Leads and campaign touches are computable and feed Pipeline generated (analytics/marketing_attribution.py), but they measure conversion to signup; they cannot yield an MQL response SLA, an MQL->SAL acceptance rate or a recycling rate, so this is a genuine gap and its three children stay blocked with it."
    },
    {
      "node_key": "brand_awareness",
      "label": "Brand & awareness",
      "layer": 2,
      "parent_key": "new_logo_consumption_revenue",
      "tier": "D_genuine_new_phase1_data",
      "blocked_node_count": 4,
      "blocks_full_layer1_metric": false,
      "rationale": "No web-traffic, branded-search or competitive-intelligence source exists anywhere in this project. Lowest actionable priority of the four-node-or-larger gaps despite its node count, because the tree itself excludes Brand & awareness from every sibling ranking (the one deliberate non-additive leading-indicator exception, per CLAUDE.md) -- closing it would add descriptive detail, never change a drill-down outcome."
    },
    {
      "node_key": "wallet_share_progression",
      "label": "Wallet share progression",
      "layer": 2,
      "parent_key": "expansion_consumption_revenue",
      "tier": "D_genuine_new_phase1_data",
      "blocked_node_count": 4,
      "blocks_full_layer1_metric": false,
      "rationale": "Needs an estimate of an account's non-Acme workflow footprint (the wallet-share denominator) -- nothing in this project's raw data or marts estimates it. This is Expansion consumption revenue's ONLY Layer-2 driver (0 of 2 computable per the variance-diagnostic engine's own coverage table, once overage_realization above is also counted) -- closing this is what it would take for the Expansion branch to produce any drill-down evidence at all when it breaches variance, which today it structurally cannot."
    },
    {
      "node_key": "time_to_first_integration",
      "label": "Time-to-first-integration / first successful run",
      "layer": 2,
      "parent_key": "activation",
      "tier": "D_genuine_new_phase1_data",
      "blocked_node_count": 1,
      "blocks_full_layer1_metric": false,
      "rationale": "No integration/first-successful-run event exists anywhere in the raw data; fact_usage_monthly is monthly grain with no first-Action timestamp."
    },
    {
      "node_key": "quickstart_docs_engagement_rate",
      "label": "Quickstart/docs content engagement rate",
      "layer": 2,
      "parent_key": "activation",
      "tier": "D_genuine_new_phase1_data",
      "blocked_node_count": 1,
      "blocks_full_layer1_metric": false,
      "rationale": "The build spec's content_engagement source was never generated at all."
    },
    {
      "node_key": "cohort_comparison",
      "label": "Cohort comparison (same account type, same period last cycle)",
      "layer": 3,
      "parent_key": "cyclical_vs_structural_usage_dip",
      "tier": "D_genuine_new_phase1_data",
      "blocked_node_count": 1,
      "blocks_full_layer1_metric": false,
      "rationale": "No mart exposes an account-type x usage-cycle cohort baseline; nothing in the raw data currently supports deriving one either."
    },
    {
      "node_key": "expansion_revenue_drivers",
      "label": "Expansion revenue drivers",
      "layer": 2,
      "parent_key": "am_efficiency",
      "tier": "E_not_a_real_gap",
      "blocked_node_count": 1,
      "blocks_full_layer1_metric": false,
      "rationale": "Not a gap of its own: the tree defines this node by reference ('See Growth -- expansion revenue drivers'), so it is computable exactly when Expansion consumption revenue's own drivers (wallet_share_progression, overage_realization, both catalogued above) are. AM cost, the other side of AM efficiency, is already a real input. No separate investment closes it."
    },
    {
      "node_key": "account_specific_baseline_deviation",
      "label": "Account-specific baseline deviation",
      "layer": 3,
      "parent_key": "cyclical_vs_structural_usage_dip",
      "tier": "E_not_a_real_gap",
      "blocked_node_count": 1,
      "blocks_full_layer1_metric": false,
      "rationale": "Not a real gap: the node's own gap_note states it is already folded into its parent's computation (usage_dip_breadth IS this leaf, aggregated) -- surfacing it separately would restate the parent, not add evidence. No investment closes this because there is nothing distinct left to compute."
    }
  ],
